{
  "db_path": {
    "description": "数据文件路径",
    "type": "string",
    "default": "data/zhenxin.sqlite3",
    "hint": "AstrBot 内默认会落到插件专属 data 目录；也可填绝对路径。",
    "obvious_hint": true
  },
  "shadow_mode": {
    "description": "影子模式（先别改回复）",
    "type": "bool",
    "default": true,
    "hint": "只记录决策与真实 usage，不修改 req，也不短路回复。首次接入强烈建议开启。",
    "obvious_hint": true
  },
  "live_allowlist": {
    "description": "金丝雀白名单（user_key 前缀）",
    "type": "list",
    "default": [],
    "hint": "shadow_mode=true 时，只有匹配这些前缀的会话走 live；留空=全部 shadow。"
  },
  "strict_zero_llm": {
    "description": "写路径零 LLM 强校验",
    "type": "bool",
    "default": true,
    "hint": "L2/亮度/置信度路径一旦调用模型就抛错，生产建议开启。"
  },
  "l0": {
    "description": "L0 · 长期线索槽位线索层",
    "type": "object",
    "hint": "长期线索只注入 2-3 条；换球有滞回，保护前缀缓存。",
    "items": {
      "enabled": {
        "description": "启用 L0",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "inject": {
        "description": "注入球数",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 3,
          "step": 1
        }
      },
      "max_inject_chars": {
        "description": "L0 字符上限",
        "type": "int",
        "default": 150,
        "slider": {
          "min": 60,
          "max": 300,
          "step": 10
        }
      },
      "max_seed_chars": {
        "description": "单个线索字数上限",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 10,
          "max": 60,
          "step": 5
        }
      },
      "decay": {
        "description": "每轮亮度衰减",
        "type": "float",
        "default": 0.99,
        "slider": {
          "min": 0.95,
          "max": 1.0,
          "step": 0.001
        }
      },
      "hysteresis": {
        "description": "换球滞回阈值",
        "type": "float",
        "default": 2.0,
        "slider": {
          "min": 0.5,
          "max": 3.0,
          "step": 0.1
        },
        "hint": "越高越稳定，越低越容易换球。"
      },
      "min_dwell_rounds": {
        "description": "最短换球间隔（轮）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "rebalance_interval": {
        "description": "重排检查间隔（轮）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "tail_injection": {
        "description": "线索块放请求末尾（保护前缀缓存）",
        "type": "bool",
        "default": true,
        "hint": "开启后线索块不写进系统提示，换线索不会让系统提示之后的整段上下文缓存失效。关闭仅用于对照测试。"
      }
    }
  },
  "shortcircuit": {
    "description": "短路器 · 习惯固化",
    "type": "object",
    "hint": "重复短句走模板/形状直答；人味敏感时先关闭。",
    "items": {
      "enabled": {
        "description": "启用短路器",
        "type": "bool",
        "default": false,
        "obvious_hint": true
      },
      "hit_threshold": {
        "description": "命中置信度",
        "type": "float",
        "default": 3.0,
        "slider": {
          "min": 1.0,
          "max": 6.0,
          "step": 0.1
        }
      },
      "max_hit_chars": {
        "description": "允许固化的最大输入长度",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 2,
          "max": 20,
          "step": 1
        }
      },
      "neg_degrade_threshold": {
        "description": "负反馈降级阈值",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 5,
          "step": 1
        }
      },
      "degrade_hours": {
        "description": "降级时长（小时）",
        "type": "float",
        "default": 24.0,
        "slider": {
          "min": 1,
          "max": 72,
          "step": 1
        }
      },
      "use_small_model": {
        "description": "中等置信度用小模型生成",
        "type": "bool",
        "default": false,
        "hint": "需要 decision_model；不会调用主模型。"
      }
    }
  },
  "l1": {
    "description": "L1 · 按需唤醒",
    "type": "object",
    "hint": "只有强指代 + 低 L0 相关 / 矛盾 / 未闭合事务才唤醒。",
    "items": {
      "enabled": {
        "description": "启用 L1",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "low_l0_threshold": {
        "description": "L0 低相关阈值",
        "type": "float",
        "default": 0.3,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        }
      },
      "candidate_min_score": {
        "description": "冷种子最低分",
        "type": "float",
        "default": 0.1,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        }
      },
      "wake_cooldown_rounds": {
        "description": "唤醒冷却（轮）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "recall_max_chars": {
        "description": "回忆片段字符上限",
        "type": "int",
        "default": 100,
        "slider": {
          "min": 40,
          "max": 200,
          "step": 10
        }
      },
      "max_recalls": {
        "description": "最多回忆条数",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 3,
          "step": 1
        }
      },
      "rerank": {
        "description": "小模型 rerank（可选）",
        "type": "bool",
        "default": false
      }
    }
  },
  "l2": {
    "description": "L2 · 零调用写入",
    "type": "object",
    "hint": "正则蒸馏；被淘汰节点物理删除。",
    "items": {
      "enabled": {
        "description": "启用 L2",
        "type": "bool",
        "default": true
      },
      "warm_limit": {
        "description": "备用线索上限",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 5,
          "max": 100,
          "step": 1
        }
      },
      "max_candidates": {
        "description": "每轮最多蒸馏候选",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 1,
          "max": 8,
          "step": 1
        }
      },
      "open_loop_limit": {
        "description": "未闭合队列上限",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "open_loop_ttl_rounds": {
        "description": "未闭合事务存活轮数",
        "type": "int",
        "default": 25,
        "slider": {
          "min": 5,
          "max": 100,
          "step": 1
        }
      }
    }
  },
  "l3": {
    "description": "L3 · 缓存感知修剪",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 L3",
        "type": "bool",
        "default": true
      },
      "cache_aware_pruning": {
        "description": "缓存感知修剪",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "recent_turns": {
        "description": "最近窗口轮数",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 2,
          "max": 30,
          "step": 1
        }
      },
      "window_grow_turns": {
        "description": "窗口回收步长（轮）",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 0,
          "max": 12,
          "step": 1
        },
        "hint": "窗口先只追加，涨到“最近窗口轮数 + 步长”才一次回收到下限；0 表示每轮滑动（旧行为，缓存命中差）。"
      },
      "recent_char_low_water": {
        "description": "超预算后回收到预算的多少",
        "type": "float",
        "default": 0.7,
        "slider": {
          "min": 0.3,
          "max": 1.0,
          "step": 0.05
        }
      },
      "recent_max_chars": {
        "description": "最近窗口字符预算",
        "type": "int",
        "default": 2200,
        "slider": {
          "min": 400,
          "max": 8000,
          "step": 100
        }
      },
      "ephemeral_max_chars": {
        "description": "临时尾部字符上限",
        "type": "int",
        "default": 420,
        "slider": {
          "min": 100,
          "max": 1000,
          "step": 20
        }
      },
      "host_context_mode": {
        "description": "宿主上下文策略",
        "type": "string",
        "default": "replace",
        "options": [
          "replace",
          "prepend",
          "off"
        ],
        "hint": "replace 省钱；off 最兼容（与别的记忆插件共存时选它）；prepend 保留宿主上下文但更费 token。"
      },
      "cache_ttl_seconds": {
        "description": "缓存 TTL 假设（秒）",
        "type": "int",
        "default": 300
      }
    }
  },
  "embedding": {
    "description": "本地嵌入",
    "type": "object",
    "hint": "不调用远程 embedding API；文件不存在时自动回退到哈希向量。",
    "items": {
      "backend": {
        "description": "后端",
        "type": "string",
        "default": "auto",
        "options": [
          "auto",
          "onnx",
          "hash"
        ]
      },
      "model_path": {
        "description": "ONNX 模型路径",
        "type": "string",
        "default": "models/bge-small-zh.onnx"
      },
      "tokenizer_path": {
        "description": "tokenizer.json 路径",
        "type": "string",
        "default": "models/tokenizer.json"
      },
      "dims": {
        "description": "哈希维度",
        "type": "int",
        "default": 384
      }
    }
  },
  "aux": {
    "description": "辅助模块",
    "type": "object",
    "items": {
      "topic_stack": {
        "description": "话题栈",
        "type": "bool",
        "default": true
      },
      "compression": {
        "description": "长消息压缩",
        "type": "bool",
        "default": true
      },
      "compression_threshold": {
        "description": "压缩触发字数",
        "type": "int",
        "default": 150,
        "slider": {
          "min": 50,
          "max": 500,
          "step": 10
        }
      },
      "rhythm": {
        "description": "回复节奏",
        "type": "bool",
        "default": true
      },
      "rhythm_postprocess": {
        "description": "节奏后处理",
        "type": "bool",
        "default": true
      },
      "lexicon": {
        "description": "用户词汇表",
        "type": "bool",
        "default": true
      },
      "open_loops": {
        "description": "未闭合事务",
        "type": "bool",
        "default": true
      },
      "negative_patterns": {
        "description": "负面模式黑名单",
        "type": "bool",
        "default": true
      }
    }
  },
  "metrics": {
    "description": "指标与真实用量",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用指标",
        "type": "bool",
        "default": true
      },
      "log_traces": {
        "description": "写 JSONL trace",
        "type": "bool",
        "default": true
      },
      "jsonl_path": {
        "description": "JSONL 路径",
        "type": "string",
        "default": "logs/metrics.jsonl"
      },
      "currency": {
        "description": "计价币种",
        "type": "string",
        "default": "CNY"
      },
      "input_price_per_million": {
        "description": "输入 ¥/百万",
        "type": "float",
        "default": 2.0
      },
      "cached_input_price_per_million": {
        "description": "缓存命中 ¥/百万",
        "type": "float",
        "default": 0.5
      },
      "output_price_per_million": {
        "description": "输出 ¥/百万",
        "type": "float",
        "default": 8.0
      }
    }
  }
}

