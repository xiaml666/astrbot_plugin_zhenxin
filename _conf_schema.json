{
  "db_path": {
    "description": "数据文件路径",
    "type": "string",
    "default": "data/zhenxin.sqlite3",
    "hint": "AstrBot 内默认会落到插件专属 data 目录；也可填绝对路径。",
    "obvious_hint": true
  },
  "shadow_mode": {
    "description": "影子模式（先别改回复）",
    "type": "bool",
    "default": true,
    "hint": "只记录决策与真实 usage，不修改 req，也不短路回复。首次接入强烈建议开启。",
    "obvious_hint": true
  },
  "live_allowlist": {
    "description": "金丝雀白名单（user_key 前缀）",
    "type": "list",
    "default": [],
    "hint": "shadow_mode=true 时，只有匹配这些前缀的会话走 live；留空=全部 shadow。"
  },
  "strict_zero_llm": {
    "description": "写路径零 LLM 强校验",
    "type": "bool",
    "default": true,
    "hint": "L2/亮度/置信度路径一旦调用模型就抛错，生产建议开启。"
  },
  "l0": {
    "description": "L0 · 长期线索槽位线索层",
    "type": "object",
    "hint": "长期线索默认注入 3 条，现在可调到 8 条；换球有滞回，保护前缀缓存。",
    "items": {
      "enabled": {
        "description": "启用 L0",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "inject": {
        "description": "注入球数",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 8,
          "step": 1
        },
        "hint": "最多 8 条。条数越多越像记得住，token 也越多；默认 3 条是实测性价比最高的档位。"
      },
      "max_inject_chars": {
        "description": "L0 字符上限",
        "type": "int",
        "default": 260,
        "slider": {
          "min": 60,
          "max": 600,
          "step": 10
        }
      },
      "max_seed_chars": {
        "description": "单个线索字数上限",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 10,
          "max": 60,
          "step": 5
        }
      },
      "decay": {
        "description": "每轮亮度衰减",
        "type": "float",
        "default": 0.99,
        "slider": {
          "min": 0.95,
          "max": 1.0,
          "step": 0.001
        }
      },
      "hysteresis": {
        "description": "换球滞回阈值",
        "type": "float",
        "default": 2.0,
        "slider": {
          "min": 0.5,
          "max": 3.0,
          "step": 0.1
        },
        "hint": "越高越稳定，越低越容易换球。"
      },
      "min_dwell_rounds": {
        "description": "最短换球间隔（轮）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "rebalance_interval": {
        "description": "重排检查间隔（轮）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "tail_injection": {
        "description": "线索块放请求末尾（保护前缀缓存）",
        "type": "bool",
        "default": true,
        "hint": "开启后线索块不写进系统提示，换线索不会让系统提示之后的整段上下文缓存失效。关闭仅用于对照测试。"
      }
    }
  },
  "shortcircuit": {
    "description": "短路器 · 习惯固化",
    "type": "object",
    "hint": "重复短句走模板/形状直答；人味敏感时先关闭。",
    "items": {
      "enabled": {
        "description": "启用短路器",
        "type": "bool",
        "default": false,
        "obvious_hint": true
      },
      "hit_threshold": {
        "description": "命中置信度",
        "type": "float",
        "default": 3.0,
        "slider": {
          "min": 1.0,
          "max": 6.0,
          "step": 0.1
        }
      },
      "max_hit_chars": {
        "description": "允许固化的最大输入长度",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 2,
          "max": 20,
          "step": 1
        }
      },
      "neg_degrade_threshold": {
        "description": "负反馈降级阈值",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 5,
          "step": 1
        }
      },
      "degrade_hours": {
        "description": "降级时长（小时）",
        "type": "float",
        "default": 24.0,
        "slider": {
          "min": 1,
          "max": 72,
          "step": 1
        }
      },
      "use_small_model": {
        "description": "中等置信度用小模型生成",
        "type": "bool",
        "default": false,
        "hint": "需要 decision_model；不会调用主模型。"
      }
    }
  },
  "l1": {
    "description": "L1 · 按需唤醒",
    "type": "object",
    "hint": "只有强指代 + 低 L0 相关 / 矛盾 / 未闭合事务才唤醒。",
    "items": {
      "enabled": {
        "description": "启用 L1",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "low_l0_threshold": {
        "description": "L0 低相关阈值",
        "type": "float",
        "default": 0.3,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        }
      },
      "candidate_min_score": {
        "description": "冷种子最低分",
        "type": "float",
        "default": 0.1,
        "slider": {
          "min": 0.0,
          "max": 1.0,
          "step": 0.01
        }
      },
      "wake_cooldown_rounds": {
        "description": "唤醒冷却（轮）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "recall_max_chars": {
        "description": "回忆片段字符上限",
        "type": "int",
        "default": 100,
        "slider": {
          "min": 40,
          "max": 200,
          "step": 10
        }
      },
      "max_recalls": {
        "description": "最多回忆条数",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 1,
          "max": 3,
          "step": 1
        }
      },
      "rerank": {
        "description": "小模型 rerank（可选）",
        "type": "bool",
        "default": false
      }
    }
  },
  "l2": {
    "description": "L2 · 零调用写入",
    "type": "object",
    "hint": "正则蒸馏；被淘汰节点物理删除。",
    "items": {
      "enabled": {
        "description": "启用 L2",
        "type": "bool",
        "default": true
      },
      "warm_limit": {
        "description": "备用线索上限",
        "type": "int",
        "default": 30,
        "slider": {
          "min": 5,
          "max": 100,
          "step": 1
        }
      },
      "max_candidates": {
        "description": "每轮最多蒸馏候选",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 1,
          "max": 8,
          "step": 1
        }
      },
      "open_loop_limit": {
        "description": "未闭合队列上限",
        "type": "int",
        "default": 5,
        "slider": {
          "min": 1,
          "max": 10,
          "step": 1
        }
      },
      "open_loop_ttl_rounds": {
        "description": "未闭合事务存活轮数",
        "type": "int",
        "default": 25,
        "slider": {
          "min": 5,
          "max": 100,
          "step": 1
        }
      }
    }
  },
  "l3": {
    "description": "L3 · 缓存感知修剪",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用 L3",
        "type": "bool",
        "default": true
      },
      "cache_aware_pruning": {
        "description": "缓存感知修剪",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "recent_turns": {
        "description": "最近窗口轮数",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 2,
          "max": 30,
          "step": 1
        }
      },
      "window_grow_turns": {
        "description": "窗口回收步长（轮）",
        "type": "int",
        "default": 4,
        "slider": {
          "min": 0,
          "max": 12,
          "step": 1
        },
        "hint": "窗口先只追加，涨到“最近窗口轮数 + 步长”才一次回收到下限；0 表示每轮滑动（旧行为，缓存命中差）。"
      },
      "recent_char_low_water": {
        "description": "超预算后回收到预算的多少",
        "type": "float",
        "default": 0.7,
        "slider": {
          "min": 0.3,
          "max": 1.0,
          "step": 0.05
        }
      },
      "recent_max_chars": {
        "description": "最近窗口字符预算",
        "type": "int",
        "default": 2200,
        "slider": {
          "min": 400,
          "max": 8000,
          "step": 100
        }
      },
      "ephemeral_max_chars": {
        "description": "临时尾部字符上限",
        "type": "int",
        "default": 420,
        "slider": {
          "min": 100,
          "max": 1000,
          "step": 20
        }
      },
      "host_context_mode": {
        "description": "宿主上下文策略",
        "type": "string",
        "default": "replace",
        "options": [
          "replace",
          "off"
        ],
        "hint": "replace 省钱；off 最兼容（与别的记忆插件共存时选它）。旧版 prepend（宿主+插件双份上下文）已删除。"
      },
      "cache_ttl_seconds": {
        "description": "缓存 TTL 假设（秒）",
        "type": "int",
        "default": 300
      }
    }
  },
  "embedding": {
    "description": "本地嵌入",
    "type": "object",
    "hint": "不调用远程 embedding API；文件不存在时自动回退到哈希向量。",
    "items": {
      "backend": {
        "description": "后端",
        "type": "string",
        "default": "auto",
        "options": [
          "auto",
          "onnx",
          "hash"
        ]
      },
      "model_path": {
        "description": "ONNX 模型路径",
        "type": "string",
        "default": "models/bge-small-zh.onnx"
      },
      "tokenizer_path": {
        "description": "tokenizer.json 路径",
        "type": "string",
        "default": "models/tokenizer.json"
      },
      "dims": {
        "description": "哈希维度",
        "type": "int",
        "default": 384
      }
    }
  },
  "aux": {
    "description": "辅助模块",
    "type": "object",
    "items": {
      "topic_stack": {
        "description": "话题栈",
        "type": "bool",
        "default": true
      },
      "compression": {
        "description": "长消息压缩",
        "type": "bool",
        "default": true
      },
      "compression_threshold": {
        "description": "压缩触发字数",
        "type": "int",
        "default": 150,
        "slider": {
          "min": 50,
          "max": 500,
          "step": 10
        }
      },
      "rhythm": {
        "description": "回复节奏",
        "type": "bool",
        "default": true
      },
      "rhythm_postprocess": {
        "description": "节奏后处理",
        "type": "bool",
        "default": true
      },
      "lexicon": {
        "description": "用户词汇表",
        "type": "bool",
        "default": true
      },
      "open_loops": {
        "description": "未闭合事务",
        "type": "bool",
        "default": true
      },
      "negative_patterns": {
        "description": "负面模式黑名单",
        "type": "bool",
        "default": true
      }
    }
  },
  "memory": {
    "description": "长期记忆 · 检索权重与遗忘周期",
    "type": "object",
    "hint": "记忆不是“越多越好”：周期结束后高价值进珍藏池、低价值进浅忆池，回收池定期彻底删除。",
    "items": {
      "enabled": {
        "description": "启用长期记忆",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "top_k": {
        "description": "每轮最多带几条记忆",
        "type": "int",
        "default": 3,
        "slider": {
          "min": 1,
          "max": 5,
          "step": 1
        }
      },
      "min_score": {
        "description": "检索最低分",
        "type": "float",
        "default": 0.3,
        "slider": {
          "min": 0.1,
          "max": 0.8,
          "step": 0.01
        },
        "hint": "越高越严格；0.30 在实测里既能接住“我不吃什么来着”，又不会乱翻旧事。"
      },
      "weight_semantic": {
        "description": "权重 · 语义相似",
        "type": "float",
        "default": 0.5,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "weight_importance": {
        "description": "权重 · 重要度",
        "type": "float",
        "default": 0.18,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "weight_recency": {
        "description": "权重 · 记忆保持度",
        "type": "float",
        "default": 0.12,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "weight_usage": {
        "description": "权重 · 被用过次数",
        "type": "float",
        "default": 0.1,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "weight_kind": {
        "description": "权重 · 记忆类型",
        "type": "float",
        "default": 0.05,
        "slider": {
          "min": 0,
          "max": 1,
          "step": 0.01
        }
      },
      "exact_boost": {
        "description": "命中原文词的加分",
        "type": "float",
        "default": 0.12,
        "slider": {
          "min": 0,
          "max": 0.5,
          "step": 0.01
        }
      },
      "address_boost": {
        "description": "称呼/名字的加分",
        "type": "float",
        "default": 0.22,
        "slider": {
          "min": 0,
          "max": 0.6,
          "step": 0.01
        },
        "hint": "用户明确说过“叫我X”时，这条记忆每轮都会带上，不靠运气检索。"
      },
      "cycle_days": {
        "description": "遗忘周期（天）",
        "type": "float",
        "default": 14.0,
        "slider": {
          "min": 1,
          "max": 60,
          "step": 1
        }
      },
      "decay_half_life_days": {
        "description": "记忆半衰期（天）",
        "type": "float",
        "default": 30.0,
        "slider": {
          "min": 3,
          "max": 120,
          "step": 1
        }
      },
      "treasure_threshold": {
        "description": "进珍藏池的强度线",
        "type": "float",
        "default": 0.62,
        "slider": {
          "min": 0.3,
          "max": 0.95,
          "step": 0.01
        }
      },
      "shallow_threshold": {
        "description": "进浅忆池的强度线",
        "type": "float",
        "default": 0.3,
        "slider": {
          "min": 0.05,
          "max": 0.6,
          "step": 0.01
        }
      },
      "trash_ttl_days": {
        "description": "回收池保留天数",
        "type": "float",
        "default": 7.0,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        },
        "hint": "到期后彻底删除，只在关键词痕迹里留一行，不再进入模型。"
      }
    }
  },
  "style_learning": {
    "description": "说话偏好 · 越聊越合拍",
    "type": "object",
    "hint": "不再模仿用户的口头禅。只从用户明确说过的偏好和论坛/聊天平台的讨论里，用小模型甄别后写入最多 500 字知识库；每轮只带一小段。",
    "items": {
      "enabled": {
        "description": "启用说话偏好学习",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "online": {
        "description": "周期性联网学习",
        "type": "bool",
        "default": true,
        "hint": "低频（默认 7 天一次）只搜论坛/聊天/社交平台；会核对结果域名，广告、SEO、英语学习页会被剔除。"
      },
      "interval_days": {
        "description": "联网学习间隔（天）",
        "type": "float",
        "default": 7.0,
        "slider": {
          "min": 1,
          "max": 30,
          "step": 1
        }
      },
      "max_chars": {
        "description": "知识库字数上限",
        "type": "int",
        "default": 500,
        "slider": {
          "min": 200,
          "max": 800,
          "step": 50
        },
        "hint": "超过上限会自动删减；每轮只注入其中约 110 字，避免上下文变长。"
      }
    }
  },
  "split": {
    "description": "对话分段 · 像真人一样连发几条",
    "type": "object",
    "hint": "默认开启。只改变发送方式：把一条长回复按句子拆成几条短消息，不增加模型调用，也不会让上下文变长。引用会挂在第一条，图片单独一条，表情嵌入文字。",
    "items": {
      "enabled": {
        "description": "启用对话分段",
        "type": "bool",
        "default": true,
        "obvious_hint": true
      },
      "max_segments": {
        "description": "最多拆成几条",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 2,
          "max": 8,
          "step": 1
        }
      },
      "min_segment_chars": {
        "description": "每段少于多少字就和相邻段合并",
        "type": "int",
        "default": 10,
        "slider": {
          "min": 2,
          "max": 30,
          "step": 1
        }
      },
      "delay_mode": {
        "description": "发送速度",
        "type": "string",
        "default": "natural",
        "options": [
          "natural",
          "fast",
          "slow"
        ],
        "hint": "natural：0.5 秒 + 0.1 秒×下一段字数；fast：固定 0.3 秒；slow：固定 2.5 秒。"
      }
    }
  },
  "proactive": {
    "description": "主动消息 · 让真心先开口",
    "type": "object",
    "hint": "默认关闭。开启后只在最近活跃的私聊、非静默时段、且满足空闲/间隔/每日上限时发一条。",
    "items": {
      "enabled": {
        "description": "启用主动消息",
        "type": "bool",
        "default": false,
        "obvious_hint": true
      },
      "min_idle_minutes": {
        "description": "对方多久没说话才发（分钟）",
        "type": "int",
        "default": 180
      },
      "min_interval_hours": {
        "description": "两次主动消息最短间隔（小时）",
        "type": "float",
        "default": 12.0
      },
      "max_per_day": {
        "description": "每个会话每天最多几条",
        "type": "int",
        "default": 2,
        "slider": {
          "min": 0,
          "max": 6,
          "step": 1
        }
      },
      "active_window_hours": {
        "description": "只考虑最近多久活跃过的会话（小时）",
        "type": "float",
        "default": 72.0
      },
      "quiet_start": {
        "description": "静默开始（点）",
        "type": "int",
        "default": 23,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        }
      },
      "quiet_end": {
        "description": "静默结束（点）",
        "type": "int",
        "default": 8,
        "slider": {
          "min": 0,
          "max": 23,
          "step": 1
        }
      },
      "only_private": {
        "description": "只发私聊",
        "type": "bool",
        "default": true
      },
      "use_llm": {
        "description": "用主模型润色（可选）",
        "type": "bool",
        "default": false,
        "hint": "关闭时用本地模板（未完成事项/高价值记忆），零额外调用。"
      },
      "max_chars": {
        "description": "单条字数上限",
        "type": "int",
        "default": 80,
        "slider": {
          "min": 20,
          "max": 200,
          "step": 10
        }
      },
      "template": {
        "description": "自定义模板（可留空）",
        "type": "string",
        "default": "",
        "hint": "可用 {loop} 表示未完成事项、{fact} 表示一条记忆、{greeting} 表示当前时间段的日常问候（吃饭了没/在干嘛呀）；留空用内置自然话术。"
      }
    }
  },
  "feedback": {
    "description": "反馈通道",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用反馈",
        "type": "bool",
        "default": true
      },
      "github_issues": {
        "description": "GitHub Issue 地址",
        "type": "string",
        "default": "https://github.com/xiaml666/astrbot_plugin_zhenxin/issues/new"
      }
    }
  },
  "metrics": {
    "description": "指标与真实用量",
    "type": "object",
    "items": {
      "enabled": {
        "description": "启用指标",
        "type": "bool",
        "default": true
      },
      "log_traces": {
        "description": "写 JSONL trace",
        "type": "bool",
        "default": true
      },
      "jsonl_path": {
        "description": "JSONL 路径",
        "type": "string",
        "default": "logs/metrics.jsonl"
      },
      "currency": {
        "description": "计价币种",
        "type": "string",
        "default": "CNY"
      },
      "input_price_per_million": {
        "description": "输入 ¥/百万",
        "type": "float",
        "default": 2.0
      },
      "cached_input_price_per_million": {
        "description": "缓存命中 ¥/百万",
        "type": "float",
        "default": 0.5
      },
      "output_price_per_million": {
        "description": "输出 ¥/百万",
        "type": "float",
        "default": 8.0
      }
    }
  }
